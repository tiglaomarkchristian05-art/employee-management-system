APP_ENV=production
APP_DEBUG=0
APP_URL=https://your-hostforge-domain.example
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-private-password
INITIAL_USER_PASSWORD=replace-with-another-strong-private-password

# HostForge injects these automatically with a managed MySQL database.
DB_CONNECTION=mysql
DB_HOST=your-internal-database-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=your-secret-password

# Required for email OTP MFA for all user roles. Never commit real credentials.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Moses HRMS Security
MFA_ADMIN_EMAIL=primary-admin@example.com
