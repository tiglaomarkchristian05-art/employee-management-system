# Core Transaction 3 - Apache configuration

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose application internals or private runtime data directly.
    RewriteRule ^(?:app|config|core|database|scripts)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:backups?|documents?)(?:/|$) - [F,L,NC]
    RewriteRule ^public/uploads(?:/|$) - [F,L,NC]

    # Block hidden files (except ACME's .well-known directory) and sensitive
    # development/database artifacts if they are ever placed in the web root.
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]
    RewriteRule "(?:^|/)(?:Dockerfile|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml(?:\.dist)?|README(?:\.[A-Za-z0-9]+)?|.*\.(?:sql|bak|backup|dump|env|ini|log|pem|key|p12|pfx))$" - [F,L,NC]

    # Keep real files/directories (CSS, JS, images, index.php) working normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Optional clean URLs: /training_courses -> index.php?page=training_courses.
    # Existing index.php?page=... links remain fully compatible.
    RewriteRule ^([A-Za-z0-9_-]+)/?$ index.php?page=$1 [QSA,L]

    # Send any other non-file request through the existing front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(?:\.env(?:\..*)?|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>
